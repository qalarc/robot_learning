<mujoco model="two_link_arm">
  <!-- Bench model: minimal 2-link planar arm written by hand for LOCAL_MUJOCO_BENCH. -->
  <option timestep="0.002" gravity="0 0 -9.81"/>
  <visual>
    <global offwidth="1280" offheight="720"/>
  </visual>
  <worldbody>
    <geom name="floor" type="plane" size="2 2 0.1" rgba="0.25 0.3 0.35 1"/>
    <light name="top" pos="0 0 2" dir="0 0 -1" diffuse="0.7 0.7 0.7"/>
    <body name="link1" pos="0 0 0.4">
      <joint name="shoulder" type="hinge" axis="0 1 0" range="-3.14 3.14" damping="0.3"/>
      <geom name="arm1" type="capsule" fromto="0 0 0 0 0 0.25" size="0.03" density="600"/>
      <body name="link2" pos="0 0 0.25">
        <joint name="elbow" type="hinge" axis="0 1 0" range="-3.14 3.14" damping="0.3"/>
        <geom name="arm2" type="capsule" fromto="0 0 0 0 0 0.25" size="0.025" density="600"/>
        <geom name="tip" type="sphere" pos="0 0 0.25" size="0.03" density="600"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <position name="a_shoulder" joint="shoulder" kp="20" ctrlrange="-3.14 3.14"/>
    <position name="a_elbow" joint="elbow" kp="20" ctrlrange="-3.14 3.14"/>
  </actuator>
</mujoco>
